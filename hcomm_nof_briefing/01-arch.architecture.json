  "cards": [
    {
      "dot": "emerald",
      "title": "零拷贝数据面",
      "items": [
        "user_buf 经 mem_map 按需注册（HcommMemReg + HcommMemExport，tokenId LRU 缓存）",
        "DPTR = keyed SGL {tokenId, user_buf 地址, 长度}，TGT 直接 RDMA 读写用户缓冲，无 bounce buffer",
        "cqe_buf[cid].padding[0] 为完成有效标记，HOST 只轮询 active_cids 在途集合",
        "HcommSendOnThread 为双边 SEND：由 A5（DEV_TYPE_950）AI CPU 上的 hcomm 传输层执行，SQE 经 channel 直达 TGT，无需 Device 侧配套应用（非 A5 返回 NOT_SUPPORT）"
      ]
    },
    {
      "dot": "amber",
      "title": "双通路设计（与 TGT 交互）",
      "items": [
        "UB channel（HcommChannelCreate，Jetty CONN_RM）：数据面，SQE 经 Device A5 传输层双边 SEND 直达 TGT",
        "NOF 侧信道（Ra* socket）：控制面，per-qpair 交换 qid / 队列深度 / ini_cqe_addr / cqe_tokenid / jetty 身份",
        "UBOE 部署预建 CLIENT socket（SocketCreate）规避 AicpuTsUboeChannel 按 IP 字节比较定角色的库 bug"
      ]
    },
    {
      "dot": "cyan",
      "title": "共享内存的两类访问者（两条回线的由来）",
      "items": [
        "sq_buf[cid]：HOST 写入 → Device A5 传输层读取（双边 SEND 的源缓冲；HOST↔Device 片内共享，出向命令流）",
        "cqe_buf[cid]：TGT NOF 服务处理完命令后经 UB RDMA 直写（凭 NOF 握手交换的 ini_cqe_addr + cqe_tokenid 定位；回向完成流）",
        "user_buf：per-request 经 mem_map 按需注册，TGT 凭 DPTR keyed SGL tokenId 直读直写（零拷贝，独立于 sq/cqe 数组）"
      ]
    },
    {
      "dot": "violet",
      "title": "资源归属（三级）",
      "items": [
        "进程级单例（引用计数）：HcommEndpoint / RaSocket 工厂 / RaCtx 工厂 / ACL 设备上下文",
        "per-ctrlr：target_addr、local_eid、NOF fd、预建 socket、mem_map（96B 单线格式）",
        "per-qpair：channel（=一条 jetty）、thread/RTSQ、sq_buf / cqe_buf、cid 池、tgt_info"
      ]
    }
  ]
}